{
  "name": "resincraft-launcher",
  "productName": "ResinCraft Launcher",
  "version": "1.1.2",
  "description": "A modern, friendly Minecraft launcher by Puirkle",
  "author": "Puirkle",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tools/*.ts\"",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.59.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "skinview3d": "^3.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ResinCoreAI/ResinCraft-Launcher.git"
  },
  "homepage": "https://github.com/ResinCoreAI/ResinCraft-Launcher"
}
