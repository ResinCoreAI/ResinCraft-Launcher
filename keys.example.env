# Copy to keys.local.env (git-ignored) and fill in. Both values are compiled into the app at build time,
# so players never have to configure them. Environment variables with the same names override this file.
RESINCRAFT_MS_CLIENT_ID=
RESINCRAFT_CURSEFORGE_KEY=
# ResinCraft Relay (see relay/README.md): where launchers connect, and the domain friends join under.
# Leave empty to build without it. Example: tls://relay.rscraft.resincore.tech:7000 and rscraft.resincore.tech
RESINCRAFT_RELAY_URL=
RESINCRAFT_RELAY_DOMAIN=
