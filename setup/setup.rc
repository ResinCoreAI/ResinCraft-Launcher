#include <winver.h>

1 ICON "../src-tauri/icons/icon.ico"
1 24 "setup.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "ResinCore"
      VALUE "FileDescription", "ResinCraft Setup"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "ResinCraft-Setup"
      VALUE "LegalCopyright", "Copyright (C) 2026 ResinCore by Puirkle"
      VALUE "OriginalFilename", "ResinCraft-Setup.exe"
      VALUE "ProductName", "ResinCraft Launcher"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
