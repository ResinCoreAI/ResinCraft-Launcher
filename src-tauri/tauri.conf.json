{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ResinCraft Launcher",
  "version": "1.4.1",
  "identifier": "ai.resincore.resincraft",
  "build": {
    "frontendDist": "../out/web",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ResinCraft Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": false,
        "backgroundColor": "#0a0912",
        "dragDropEnabled": true,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' https: data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Puirkle",
    "copyright": "Copyright © 2026 ResinCore by Puirkle",
    "category": "Game",
    "fileAssociations": [
      { "ext": ["rctheme"], "name": "ResinCraft theme", "description": "ResinCraft Launcher theme", "role": "Viewer", "mimeType": "application/json" },
      { "ext": ["resincraft"], "name": "ResinCraft backup", "description": "ResinCraft Launcher backup", "role": "Editor" }
    ],
    "shortDescription": "A modern Minecraft: Java Edition launcher",
    "longDescription": "ResinCraft Launcher by Puirkle: separate instances for every Minecraft version and modpack, mods from Modrinth, CurseForge, FTB, ATLauncher and Technic, and Java handled for you.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEMDk0MTk2RDAzM0UwQUYKUldTdjREUFFsa0VKSFRFa1NFK0dtK3p4TXd0bTRMQlExMmFQK0Jlc3FTUm9NWWtzWW1BSlR4a2kK",
      "endpoints": [
        "https://raw.githubusercontent.com/ResinCoreAI/ResinCraft-Launcher/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
