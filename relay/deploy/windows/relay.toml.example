# ResinCraft Relay on Windows Server. install-relay.ps1 copies this to C:\ResinCraft\relay\relay.toml the first
# time (and never overwrites your relay.toml afterwards). Relative paths are next to relay.toml.
# Every option is explained in README.md.

# Players join <name>.rscraft.resincore.tech (DNS: *.rscraft A record → this server, DNS only).
base_domain = "rscraft.resincore.tech"

# Players (Minecraft).
public_listen = ["0.0.0.0:25565"]
# ResinCraft Launcher connects here (TLS). The launcher is built with
# RESINCRAFT_RELAY_URL=tls://relay.rscraft.resincore.tech:7000 and RESINCRAFT_RELAY_DOMAIN=rscraft.resincore.tech.
agent_listen = ["0.0.0.0:7000"]
# Bedrock servers: each one online gets a UDP port of its own from this range (players add
# <name>.rscraft.resincore.tech with that port). install-relay.ps1 opens the range for UDP. "" turns them off.
bedrock_ports = "19200-19299"
bedrock_ip = "0.0.0.0"
# /healthz and /metrics for this machine only (no firewall rule needed).
admin_listen = "127.0.0.1:7001"

data_file = "data/relay.json"
log_file = "logs/relay.log"     # daily files: logs\relay.2026-10-18.log …
log_keep_days = 30
log_format = "text"
drain_secs = 10

# The certificate for rscraft.resincore.tech from win-acme's PEM files store (see README.md). The relay notices
# renewed files within a few minutes, no restart needed.
[tls]
cert = "certs/relay-chain.pem"
key = "certs/relay-key.pem"

# Admin dashboard: https://rscraft.resincore.tech:7443
# install-relay.ps1 asks for the password; to change it later:
#   C:\ResinCraft\relay\resincraft-relay.exe --config C:\ResinCraft\relay\relay.toml set-admin-password
[dashboard]
listen = "0.0.0.0:443"          # https://rscraft.resincore.tech/admin ("127.0.0.1:7443": only from this server)
password_hash = ""              # written by set-admin-password
allow_ips = []                  # optional: e.g. ["203.0.113.7", "198.51.100.0/24"]
session_hours = 12

[limits]
tunnels_per_account = 3         # servers online at once per Minecraft account
names_per_account = 5           # names reserved per account
connections_per_tunnel = 64     # players on one server at once
connections_per_ip = 16         # players from one IP at once
agents_per_ip = 16              # launchers from one IP at once
monthly_gb_per_account = 100    # traffic per account per month (UTC), both ways; 0 = unlimited
session_minutes = 120          # a relay session lasts this long; the host presses Continue for another. 0 = no limit
session_warn_minutes = [10, 1] # when the host's launcher warns (Console banner, toast, in-game chat)
session_continue_minutes = 15  # the host may press Continue once this many minutes are left (and gets a reminder)
topup_gb = 30                  # one top-up adds this much for the rest of the month
topups_per_month = 3           # top-ups a host may take per month; 0 = only the admin adds data (dashboard: Usage)
topup_low_gb = 1               # the host may top up once less than this is left (or after running out)
handshake_timeout_secs = 5
idle_timeout_secs = 300
logins_per_ip_per_hour = 20
name_expiry_days = 180          # names nobody brought online for this long are freed
session_days = 30
max_pending_handshakes = 2048

[auth]
profile_url = "https://api.minecraftservices.com/minecraft/profile"
reserved_names = []             # more can be added in the dashboard

[bans]
uuids = []                      # bans added in the dashboard are kept in data\relay.json
ips = []

[admin]
tokens = []                     # bearer tokens for the local /admin API (optional; the dashboard doesn't need them)

[custom_domains]
enabled = true
resolvers = ["1.1.1.1:53", "8.8.8.8:53"]
