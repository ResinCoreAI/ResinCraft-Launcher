# systemd unit for ResinCraft Relay (the alternative to Docker).
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin resincraft-relay
#   sudo install -m 0755 resincraft-relay /usr/local/bin/
#   sudo install -d -o resincraft-relay -g resincraft-relay /etc/resincraft-relay /etc/resincraft-relay/tls
#   sudo install -m 0640 -g resincraft-relay relay.toml /etc/resincraft-relay/relay.toml
#   sudo cp resincraft-relay.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now resincraft-relay
[Unit]
Description=ResinCraft Relay (Minecraft tunnels for ResinCraft Launcher)
Documentation=https://github.com/ResinCoreAI/ResinCraft-Launcher/tree/main/relay
After=network-online.target
Wants=network-online.target

[Service]
User=resincraft-relay
Group=resincraft-relay
ExecStart=/usr/local/bin/resincraft-relay --config /etc/resincraft-relay/relay.toml
ExecStartPre=/usr/local/bin/resincraft-relay --config /etc/resincraft-relay/relay.toml check
Restart=on-failure
RestartSec=2
# SIGTERM: stop accepting, tell launchers to reconnect, let players finish for drain_secs, save, exit.
KillSignal=SIGTERM
TimeoutStopSec=20
LimitNOFILE=65536
Environment=RUST_LOG=info
# /var/lib/resincraft-relay, owned by the service user (set data_file there).
StateDirectory=resincraft-relay

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
